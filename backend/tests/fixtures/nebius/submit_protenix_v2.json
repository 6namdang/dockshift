{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-run-request/v1",
  "title": "Scientific batch run request",
  "description": "User-authored request for POST /v1/models/{model_id}:submit. Idempotency is supplied in the Idempotency-Key HTTP header; queue, image, command, environment, and accelerator placement remain operator-owned.",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "service_class",
    "input_manifest",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
    },
    "operation": {
      "enum": [
        "predict-complex-structure"
      ]
    },
    "service_class": {
      "enum": [
        "customer-batch"
      ]
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://fs2-serve.nebius.ai/schema/protenix-v2-upstream-v2-0-0-parameters/v1",
      "title": "Protenix v2.0.0 scientific run parameters",
      "description": "Mirrors fs2_serve.scientific_batch.adapters.protenix_v2.Parameters.parse: the exact verified v2 composite checkpoint, the relocatable no-MSA lane, and bounded unique seeds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "msa_mode",
        "sample_count",
        "model_seeds"
      ],
      "properties": {
        "checkpoint": {
          "const": "protenix-v2"
        },
        "msa_mode": {
          "const": "none",
          "description": "Precomputed MSA is unsupported until every chain field and referenced file has a validated relocation contract; no supported mode contacts an MSA server."
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "model_seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "output_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Directory in your assigned bucket for automatic result.json, artifacts and manifest.json delivery. Defaults to runs/<model-id>; the operation ID is appended. Never sent to the model."
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 200
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "media_type": {
          "const": "application/vnd.fs2.scientific-manifest+json"
        },
        "compression": {
          "enum": [
            "none"
          ]
        }
      }
    }
  }
}