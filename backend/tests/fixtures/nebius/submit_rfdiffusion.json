{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-run-request/v1",
  "title": "Scientific batch run request",
  "description": "User-authored request for POST /v1/models/{model_id}:submit. Idempotency is supplied in the Idempotency-Key HTTP header; queue, image, command, environment, and accelerator placement remain operator-owned.",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "service_class",
    "input_manifest",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
    },
    "operation": {
      "enum": [
        "design-backbone",
        "scaffold-motif"
      ]
    },
    "service_class": {
      "enum": [
        "customer-batch",
        "bulk-backfill"
      ]
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://fs2-serve.nebius.ai/schema/rfdiffusion-parameters/v1",
      "title": "RFdiffusion v1.1.0 scientific run parameters",
      "description": "Bounded public inputs for unconditional backbone design or motif scaffolding. The adapter performs the remaining cross-field contig, length, motif, and seed-range checks.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "contigs",
        "num_designs",
        "seed",
        "diffuser_T"
      ],
      "properties": {
        "schema": {
          "const": "fs2-serve.nebius.ai/rfdiffusion-parameters/v1"
        },
        "operation": {
          "enum": [
            "design-backbone",
            "scaffold-motif"
          ]
        },
        "contigs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9/-]+$"
          }
        },
        "num_designs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "diffuser_T": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "hotspot_residues": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][0-9]{1,5}$"
          }
        },
        "input_pdb_artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "motif_ca_rmsd_limit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "scaffold-motif"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "input_pdb_artifact_id"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input_pdb_artifact_id"
                  ]
                },
                {
                  "required": [
                    "hotspot_residues"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "output_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Directory in your assigned bucket for automatic result.json, artifacts and manifest.json delivery. Defaults to runs/<model-id>; the operation ID is appended. Never sent to the model."
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 200
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "media_type": {
          "const": "application/vnd.fs2.scientific-manifest+json"
        },
        "compression": {
          "enum": [
            "none"
          ]
        }
      }
    }
  }
}