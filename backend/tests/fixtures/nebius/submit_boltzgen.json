{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://fs2-serve.nebius.ai/schema/scientific-run-request/v1",
  "title": "Scientific batch run request",
  "description": "User-authored request for POST /v1/models/{model_id}:submit. Idempotency is supplied in the Idempotency-Key HTTP header; queue, image, command, environment, and accelerator placement remain operator-owned.",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "service_class",
    "input_manifest",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "fs2-serve.nebius.ai/scientific-run-request/v1"
    },
    "operation": {
      "enum": [
        "design-binders"
      ]
    },
    "service_class": {
      "enum": [
        "customer-batch",
        "bulk-backfill"
      ]
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://fs2-serve.nebius.ai/schema/boltzgen-parameters/v1",
      "title": "BoltzGen scientific run parameters",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "batches"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "protein-anything",
            "peptide-anything",
            "protein-small_molecule",
            "nanobody-anything",
            "antibody-anything",
            "protein-redesign"
          ]
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "Up to two independent shards, at most 24 candidate designs in total. Scale larger campaigns using concurrent requests.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shard_id",
              "num_designs",
              "budget",
              "reuse_completed"
            ],
            "properties": {
              "shard_id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
                "maxLength": 32
              },
              "num_designs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "budget": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "reuse_completed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "output_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Directory in your assigned bucket for automatic result.json, artifacts and manifest.json delivery. Defaults to runs/<model-id>; the operation ID is appended. Never sent to the model."
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 200
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "media_type": {
          "const": "application/vnd.fs2.scientific-manifest+json"
        },
        "compression": {
          "enum": [
            "none"
          ]
        }
      }
    }
  }
}