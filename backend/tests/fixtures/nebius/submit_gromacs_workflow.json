{
  "type": "object",
  "$defs": {
    "ArtifactPointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 53687091200,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "compression": {
          "default": "none",
          "title": "Compression",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactPointer",
      "type": "object"
    },
    "Submit": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "default": "fs2-serve.nebius.ai/scientific-run-request/v1",
          "pattern": "^fs2\\-serve\\.nebius\\.ai/scientific\\-run\\-request/v1$",
          "title": "Schema",
          "type": "string"
        },
        "operation": {
          "default": "run-workflow",
          "pattern": "^run-workflow$",
          "title": "Operation",
          "type": "string"
        },
        "service_class": {
          "default": "customer-batch",
          "title": "Service Class",
          "type": "string"
        },
        "input_manifest": {
          "$ref": "#/$defs/ArtifactPointer"
        },
        "parameters": {
          "$ref": "#/$defs/WorkflowParameters"
        },
        "client_context": {
          "additionalProperties": true,
          "title": "Client Context",
          "type": "object"
        }
      },
      "required": [
        "input_manifest",
        "parameters"
      ],
      "title": "Submit",
      "type": "object"
    },
    "WorkflowParameters": {
      "$id": "https://fs2-serve.nebius.ai/schema/gromacs-workflow-request/v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "NVIDIA-optimized GROMACS native preparation, MD, minimization, analysis and free-energy tools. Supply one immutable gzip-tar input bundle containing all required topology/force-field includes, coordinates, MDP/TPR and optional checkpoints. Physics and trajectory cadence remain in the supplied protocol. Docking pose search and external extension builds are separate capabilities.",
      "properties": {
        "schema": {
          "const": "fs2-serve.nebius.ai/gromacs-workflow-request/v1"
        },
        "continuation_files": {
          "description": "Generated by the checkpoint-resume endpoint: verified input artifact IDs mapped to native workspace paths. Use :resume rather than assembling these by hand. Files stream directly from object storage to the worker.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "input_id": {
                "pattern": "^resume-[0-9]{5}$",
                "type": "string"
              },
              "path": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "input_id",
              "path"
            ],
            "type": "object"
          },
          "maxItems": 32766,
          "minItems": 1,
          "type": "array"
        },
        "jobs": {
          "description": "Independent single-GPU jobs, e.g. replicas or lambda windows. Steps within each job run in order. Different jobs do not share mutable files.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]{0,47}$",
                "type": "string"
              },
              "steps": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "pattern": "^[a-z][a-z0-9-]{0,47}$",
                      "type": "string"
                    },
                    "command": {
                      "description": "Native tool from the pinned NVIDIA GROMACS distribution; not a shell command.",
                      "enum": [
                        "anaeig",
                        "analyze",
                        "angle",
                        "awh",
                        "bar",
                        "bundle",
                        "check",
                        "chi",
                        "cluster",
                        "clustsize",
                        "confrms",
                        "convert-tpr",
                        "convert-trj",
                        "covar",
                        "current",
                        "density",
                        "densmap",
                        "densorder",
                        "dielectric",
                        "dipoles",
                        "disre",
                        "distance",
                        "dos",
                        "dssp",
                        "dump",
                        "dyecoupl",
                        "editconf",
                        "eneconv",
                        "enemat",
                        "energy",
                        "extract-cluster",
                        "filter",
                        "freevolume",
                        "gangle",
                        "genconf",
                        "genion",
                        "genrestr",
                        "grompp",
                        "gyrate",
                        "gyrate-legacy",
                        "h2order",
                        "hbond",
                        "hbond-legacy",
                        "helix",
                        "helixorient",
                        "help",
                        "hydorder",
                        "insert-molecules",
                        "lie",
                        "make_edi",
                        "make_ndx",
                        "mdmat",
                        "mdrun",
                        "mindist",
                        "mk_angndx",
                        "msd",
                        "nmeig",
                        "nmens",
                        "nmr",
                        "nmtraj",
                        "nonbonded-benchmark",
                        "order",
                        "pairdist",
                        "pdb2gmx",
                        "pme_error",
                        "polystat",
                        "potential",
                        "principal",
                        "rama",
                        "rdf",
                        "report-methods",
                        "rms",
                        "rmsdist",
                        "rmsf",
                        "rotacf",
                        "rotmat",
                        "saltbr",
                        "sans-legacy",
                        "sasa",
                        "saxs-legacy",
                        "scattering",
                        "select",
                        "sham",
                        "sigeps",
                        "solvate",
                        "sorient",
                        "spatial",
                        "spol",
                        "tcaf",
                        "traj",
                        "trajectory",
                        "trjcat",
                        "trjconv",
                        "trjorder",
                        "vanhove",
                        "velacc",
                        "wham",
                        "wheel",
                        "x2top",
                        "xpm2ps"
                      ],
                      "type": "string"
                    },
                    "args": {
                      "description": "Exact argv tokens, or a {files: relative-pattern} expansion. trjcat/eneconv -f selectors skip zero-byte segments by default; all other selectors include them. Set nonempty explicitly to override. Raw files are retained. Patterns must match eligible existing files. No shell expansion. Do not include gmx or platform-managed mdrun flags.",
                      "items": {
                        "oneOf": [
                          {
                            "maxLength": 4096,
                            "minLength": 1,
                            "type": "string"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "files": {
                                "maxLength": 512,
                                "minLength": 1,
                                "type": "string"
                              },
                              "nonempty": {
                                "description": "Exclude zero-byte matches from this argument only. Defaults to true for trjcat/eneconv -f input selectors, false elsewhere. Explicit false includes empty files. All files remain in checkpoints and outputs. An expansion with no eligible files is an error.",
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "files"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      "maxItems": 256,
                      "type": "array"
                    },
                    "directory": {
                      "default": ".",
                      "description": "Working directory relative to the extracted input bundle.",
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "stdin": {
                      "default": "",
                      "description": "Explicit newline-separated interactive selections, e.g. Protein\\n0\\n. EOF follows; no interactive terminal.",
                      "maxLength": 16384,
                      "type": "string"
                    },
                    "restart_checkpoint": {
                      "description": "Optional native .cpt path relative to directory. Missing files are errors, never a silent fresh simulation.",
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "plumed_input": {
                      "description": "PLUMED input file relative to directory for an mdrun step. Uses the packaged kernel; GROMACS passes native checkpoint/restart events to PLUMED. Include all bias/restart files in the input bundle when continuing an external run.",
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string"
                    },
                    "expected_outputs": {
                      "default": [],
                      "description": "Files relative to directory which must exist and be nonempty after this command. Do not use globs.",
                      "items": {
                        "maxLength": 512,
                        "minLength": 1,
                        "type": "string"
                      },
                      "maxItems": 256,
                      "type": "array",
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "id",
                    "command",
                    "args"
                  ],
                  "type": "object"
                },
                "maxItems": 64,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "id",
              "steps"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "threads": {
          "default": 8,
          "description": "OpenMP threads per single thread-MPI rank, within the initial eight-vCPU execution shape.",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "checkpoint_minutes": {
          "default": 5,
          "description": "Native .cpt write cadence. A local checkpoint alone does not survive node loss.",
          "maximum": 60,
          "minimum": 0.1,
          "type": "number"
        },
        "segment_minutes": {
          "default": 5,
          "description": "MD stops cleanly at this wall-time interval to publish a coherent checkpoint and closed output segment; then resumes with -noappend. Native neighbor-search boundaries can delay the stop.",
          "maximum": 60,
          "minimum": 0.1,
          "type": "number"
        },
        "max_wall_seconds": {
          "default": 1209600,
          "description": "Cumulative workflow execution budget in seconds (default and maximum fourteen days), including checkpoint I/O. Exhaustion preserves a coherent native checkpoint and reports WORKFLOW_TIME_LIMIT_EXCEEDED, not scientific success. Explicit continuations and infrastructure retries retain the original parameters and subtract saved elapsed execution time; resuming does not renew an exhausted budget.",
          "maximum": 1209600,
          "minimum": 60,
          "type": "integer"
        },
        "max_output_bytes": {
          "default": null,
          "description": "Optional explicit cap on retained workspace bytes, including inputs and outputs. Omit to use available authorized storage without an additional workflow cap. Execution scratch and customer bucket capacity still apply; native files and output cadence are preserved.",
          "minimum": 1048576,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_destination": {
          "default": "customer-bucket",
          "description": "Copy coherent native checkpoints and trajectory segments into the submitting user's assigned tenant/user bucket, as well as durable platform artifacts. Customer objects are retained until the customer deletes them or applies their bucket lifecycle; the platform never silently deletes them.",
          "enum": [
            "customer-bucket",
            "platform-artifacts"
          ]
        },
        "output_prefix": {
          "default": "runs/gromacs",
          "description": "Customer-bucket prefix. The platform appends operation ID and replica ID, so independent runs cannot overwrite each other.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "jobs"
      ],
      "type": "object"
    }
  },
  "properties": {
    "request": {
      "$ref": "#/$defs/Submit"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "request",
    "idempotency_key"
  ],
  "title": "submit_gromacs_workflowArguments",
  "additionalProperties": false
}
