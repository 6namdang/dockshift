# Copy to backend/.env and fill in. Everything is optional except where noted.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Literature search -------------------------------------------------------
CONTACT_EMAIL=
NCBI_API_KEY=

# Full text is fetched automatically only for hits whose lexical confidence (0-1)
# is >= this threshold, for at most FULLTEXT_MAX_DOCS hits per search, and is
# truncated to FULLTEXT_MAX_CHARS characters.
FULLTEXT_CONFIDENCE_THRESHOLD=0.75
FULLTEXT_MAX_DOCS=3
FULLTEXT_MAX_CHARS=20000
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# --- LLM candidate proposal --------------------------------------------------
# Any OpenAI-compatible endpoint. OPENAI_MODEL is accepted as an alias for
# LLM_MODEL. Without an API key, only literature-derived candidate proposal is
# unavailable; the fixed shortlist, QSAR, literature, and structural flows work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
LLM_MAX_DOCUMENTS=24
LLM_MAX_ABSTRACT_CHARS=700

# --- Structural discovery ----------------------------------------------------
# REST structural execution and HTTP MCP are independently disabled by default.
# Enabling either transport requires its own strong Bearer token. The REST token
# is never reused for MCP. Local MCP stdio requires neither HTTP token.
STRUCTURAL_REST_ENABLED=false
# STRUCTURAL_API_TOKEN=replace-with-a-long-random-rest-secret
MCP_HTTP_ENABLED=false
# MCP_HTTP_TOKEN=replace-with-a-different-long-random-mcp-secret
STRUCTURAL_MAX_CONCURRENT_JOBS=1

# Runtime artifacts and caller-provided scientific inputs use separate roots.
# Relative roots resolve beneath backend/. Put input structures/bundles only in
# STRUCTURAL_INPUT_ROOT; arbitrary backend files are never accepted as inputs.
STRUCTURAL_ARTIFACT_ROOT=.dockshift-runs
STRUCTURAL_INPUT_ROOT=.dockshift-inputs
STRUCTURAL_COMMAND_TIMEOUT_SECONDS=1800
STRUCTURAL_LOG_MAX_BYTES=10000000
TMALIGN_EXECUTABLE=TMalign
FPOCKET_EXECUTABLE=fpocket
VINA_EXECUTABLE=vina
OBABEL_EXECUTABLE=obabel
GROMACS_EXECUTABLE=gmx

# Official AlphaFold 3 local runner. All four settings must be valid to run AF3.
# Model parameters require separate access under Google's terms; databases are large.
ALPHAFOLD3_PYTHON_EXECUTABLE=python
# ALPHAFOLD3_SCRIPT=/opt/alphafold3/run_alphafold.py
# ALPHAFOLD3_MODEL_DIR=/data/alphafold3/models
# ALPHAFOLD3_DATABASE_DIR=/data/alphafold3/databases

# Integrated agents: execution uses STRUCTURAL_REST_ENABLED / STRUCTURAL_API_TOKEN.
# Keep compute off until remote or local scientific jobs have been approved.
AGENT_COMPUTE_ENABLED=false
AGENT_ARTIFACT_ROOT=.dockshift-agent-runs
# AGENT_NEBIUS_BINDER_TOOL=<reviewed exact discovered tool name>
# Managed candidate research: single-molecule ADMET has its own narrow authorization.
AGENT_ADMET_ENABLED=false
AGENT_REMOTE_WAIT_SECONDS=60
AGENT_MAX_ARTIFACT_BYTES=20000000
# Nebius Token Factory is the only supported collective-agent LLM provider.
# Its key is configured explicitly, separately from the scientific MCP credential.
AGENT_LLM_ENABLED=false
NEBIUS_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_LLM_API_KEY=<your-token-factory-key>
# NEBIUS_LLM_MODEL=<exact-id-from-your-authenticated-model-catalog>
