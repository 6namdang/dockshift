# Copy to backend/.env and fill in. Everything is optional except where noted.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Literature search ---------------------------------------------------------
# Contact address sent to NCBI and Crossref (both ask for one; gets you better rate limits).
CONTACT_EMAIL=

# Optional: raises PubMed's limit from 3 to 10 requests/second.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=

# Full text is fetched automatically only for hits whose lexical confidence (0-1)
# is >= this threshold, for at most FULLTEXT_MAX_DOCS hits per search, and is
# truncated to FULLTEXT_MAX_CHARS characters.
FULLTEXT_CONFIDENCE_THRESHOLD=0.75
FULLTEXT_MAX_DOCS=3
FULLTEXT_MAX_CHARS=20000

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# --- LLM agent (next step; not used yet) ---------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=
