# Copy to backend/.env and fill in. Everything is optional except where noted.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Literature search -------------------------------------------------------
CONTACT_EMAIL=
NCBI_API_KEY=
LENS_API_TOKEN=
FULLTEXT_CONFIDENCE_THRESHOLD=0.75
FULLTEXT_MAX_DOCS=3
FULLTEXT_MAX_CHARS=20000
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# --- Structural discovery ----------------------------------------------------
# REST structural execution and HTTP MCP are independently disabled by default.
# Enabling either transport requires its own strong Bearer token. The REST token
# is never reused for MCP. Local MCP stdio requires neither HTTP token.
STRUCTURAL_REST_ENABLED=false
# STRUCTURAL_API_TOKEN=replace-with-a-long-random-rest-secret
MCP_HTTP_ENABLED=false
# MCP_HTTP_TOKEN=replace-with-a-different-long-random-mcp-secret
STRUCTURAL_MAX_CONCURRENT_JOBS=1

# Runtime artifacts and caller-provided scientific inputs use separate roots.
# Relative roots resolve beneath backend/. Put input structures/bundles only in
# STRUCTURAL_INPUT_ROOT; arbitrary backend files are never accepted as inputs.
STRUCTURAL_ARTIFACT_ROOT=.dockshift-runs
STRUCTURAL_INPUT_ROOT=.dockshift-inputs
STRUCTURAL_COMMAND_TIMEOUT_SECONDS=1800
STRUCTURAL_LOG_MAX_BYTES=10000000
TMALIGN_EXECUTABLE=TMalign
FPOCKET_EXECUTABLE=fpocket
VINA_EXECUTABLE=vina
OBABEL_EXECUTABLE=obabel
GROMACS_EXECUTABLE=gmx

# Official AlphaFold 3 local runner. All four settings must be valid to run AF3.
# Model parameters require separate access under Google's terms; databases are large.
ALPHAFOLD3_PYTHON_EXECUTABLE=python
# ALPHAFOLD3_SCRIPT=/opt/alphafold3/run_alphafold.py
# ALPHAFOLD3_MODEL_DIR=/data/alphafold3/models
# ALPHAFOLD3_DATABASE_DIR=/data/alphafold3/databases
